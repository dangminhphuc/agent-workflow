#!/usr/bin/env sh
# Điểm vào của engine. Wrapper `aw` (cài global) chọn đúng version rồi gọi file
# này với AW_REPO, AW_CONFIG đã đặt — xem tools/lib/env.sh.
#
#   aw-engine version
#   aw-engine init [--adapter <id>[,<id>…]] [--test-cmd "<cmd>"] [--force]
#   aw-engine check <name> <feature-dir> [args]   name: intake spec design plan implement security review repro perf ship
#   aw-engine feature [name]
#   aw-engine input [--skip <intake.md>] <args|->
#   aw-engine pending <feature-dir>
#   aw-engine rules <phase>
#   aw-engine knowledge spec|design <feature-dir> kiến thức bền phase phải đọc (luật BR-, ADR, tài liệu module)
#   aw-engine adr promote <feature-dir> D-NN | adr check   nâng D-xx đã duyệt thành ADR; kiểm thư mục ADR
#   aw-engine rule promote <feature-dir> YC-NNN | rule check   nâng YC đã duyệt thành luật BR-; kiểm luật
#   aw-engine conventions check                   kiểm conventions.md sau khi người sửa
#   aw-engine ready <feature-dir> [--no-test]       worktree sẵn sàng chưa, bước tiếp là gì
#   aw-engine task start|done|next <feature-dir> [T-NN] [--manual "<bằng chứng>"]
#   aw-engine journal [report] | journal add <layer> <mô tả> [--feature <dir>]
#   aw-engine based-on <feature-dir> <artifact> <input>...
#   aw-engine rename <new-branch>
#   aw-engine guard pre|post                      hook gác ô duyệt (Claude Code)
#   aw-engine approval design|plan <feature-dir>  cổng duyệt khi vào phase: còn gì chờ người duyệt
#   aw-engine worktree new <type> <desc> [--create --base <ref>]
#   aw-engine worktree status <branch>
#   aw-engine worktree remove <branch> [--delete-branch]
#   aw-engine ship targets|status <feature-dir>
#   aw-engine ship create <feature-dir> --target <branch> [--draft] [--allow-extra-commits] [--url <link>]
#   aw-engine ship sweep [<branch>] [--apply]       dọn việc đã merge — từ checkout chính
#   aw-engine adapter build [<agent>[,<agent>…]] [--out <dir>] [--force]   bỏ trống agent = ADAPTER trong config.sh
#
# Engine tự biết thư mục của mình (AW_ENGINE) — đó là đường dẫn trong engine,
# không phải đường dẫn repo hay cấu hình.

AW_ENGINE=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
export AW_ENGINE
T="$AW_ENGINE/tools"
. "$T/lib/commands.sh"

# Giao thức giữa wrapper và engine. Wrapper cũ/mới hơn mà khác giao thức thì
# dừng: đừng để wrapper truyền thiếu biến mà engine vẫn chạy.
AW_ENGINE_PROTOCOL=1

sai() { # <mã> <thông báo...>
  _m=$1; shift
  . "$T/lib/result.sh"
  kq_khai aw \
    "2=SAI THAM SỐ — xem thông báo phía trên" \
    "9=KHÔNG HỢP LỆ — engine không chạy được trong trạng thái này, lý do phía trên"
  for _l in "$@"; do echo "$_l" >&2; done
  exit "$_m"
}

if [ -n "${AW_PROTOCOL:-}" ] && [ "$AW_PROTOCOL" != "$AW_ENGINE_PROTOCOL" ]; then
  sai 9 "LỖI: wrapper aw dùng giao thức $AW_PROTOCOL, engine $(cat "$AW_ENGINE/VERSION") dùng giao thức $AW_ENGINE_PROTOCOL." \
        "      Cài lại wrapper aw cùng bản với engine (xem README, mục Cài aw)."
fi

can_repo() {
  [ -n "${AW_REPO:-}" ] && [ -n "${AW_CONFIG:-}" ] ||
    sai 9 "LỖI: thiếu AW_REPO hoặc AW_CONFIG — gọi qua wrapper aw, không gọi aw-engine trực tiếp."
}

LENH="${1:-}"; [ $# -gt 0 ] && shift
case "$LENH" in
  version)
    cat "$AW_ENGINE/VERSION" ;;
  check)
    [ $# -ge 2 ] || sai 2 "Dùng: aw check <name> <feature-dir>   (name: $BL_CHECKERS)"
    s=$(bl_checker "$1") || sai 2 "LỖI: không có checker \"$1\" (có: $BL_CHECKERS)."
    can_repo; ten=$1; shift
    # Ghim version theo việc: intake.md ghi Engine nào thì chỉ engine đó được chấm.
    if [ -f "$1/intake.md" ]; then
      . "$T/lib/md.sh"; . "$T/lib/cross-check.sh"
      ev=$(kc_engine_dong "$1"); dang=$(cat "$AW_ENGINE/VERSION")
      if [ -n "$ev" ] && [ "$ev" != "$dang" ]; then
        sai 9 "LỖI: $1/intake.md ghim Engine $ev, đây là engine $dang — không chấm bằng version khác." \
              "      Chạy qua wrapper: aw check $ten $1"
      fi
      if [ -z "$ev" ] && [ "$ten" != intake ]; then
        sai 9 "LỖI: $1/intake.md thiếu dòng \"- **Engine:** YYYY.M.N\" — không biết việc này dùng engine nào." \
              "      Thêm dòng đó (version lúc tạo việc: aw version), rồi chạy: aw check intake $1"
      fi
    fi
    # Nhật ký harness (aw journal): ghi mỗi lần chạy — checker nào, đạt không,
    # vi phạm đầu tiên. stdout vẫn chảy ra ngay (tee); mã thoát giữ nguyên.
    [ "${AW_JOURNAL:-1}" = 0 ] && exec sh "$T/$s" "$@"
    _nk="${TMPDIR:-/tmp}/aw-nk.$$"
    { sh "$T/$s" "$@"; echo $? > "$_nk.ma"; } | tee "$_nk"
    _ma=$(cat "$_nk.ma" 2>/dev/null); _ma=${_ma:-1}
    sh "$T/journal.sh" _check "$ten" "$1" "$_ma" "$_nk" >/dev/null 2>&1
    rm -f "$_nk" "$_nk.ma"
    exit "$_ma" ;;
  init)      can_repo; exec sh "$T/init.sh" "$@" ;;
  feature)   can_repo; exec sh "$T/feature.sh" "$@" ;;
  input)     can_repo; exec sh "$T/input.sh" "$@" ;;
  pending)   can_repo; exec sh "$T/pending.sh" "$@" ;;
  rules)     can_repo; exec sh "$T/rules.sh" "$@" ;;
  knowledge) can_repo; exec sh "$T/knowledge.sh" "$@" ;;
  adr)       can_repo; exec sh "$T/adr.sh" "$@" ;;
  rule)      can_repo; exec sh "$T/rule.sh" "$@" ;;
  conventions)
    [ "${1:-}" = check ] || sai 2 "Dùng: aw conventions check"
    shift; can_repo; exec sh "$T/check-conventions.sh" "$@" ;;
  ready)     can_repo; exec sh "$T/ready.sh" "$@" ;;
  task)      can_repo; exec sh "$T/task.sh" "$@" ;;
  journal)   can_repo; exec sh "$T/journal.sh" "$@" ;;
  based-on)  can_repo; exec sh "$T/based-on.sh" "$@" ;;
  rename)    can_repo; exec sh "$T/rename-feature.sh" "$@" ;;
  guard)     can_repo; exec sh "$T/guard.sh" "$@" ;;
  approval)  can_repo; exec sh "$T/approval.sh" "$@" ;;
  worktree)
    can_repo
    sub="${1:-}"; [ $# -gt 0 ] && shift
    case "$sub" in
      new)    exec sh "$T/worktree-new.sh" "$@" ;;
      status) exec sh "$T/worktree-cleanup.sh" "$@" ;;
      remove) exec sh "$T/worktree-cleanup.sh" "$@" --remove ;;
      *) sai 2 "Dùng: aw worktree new|status|remove …" ;;
    esac ;;
  ship)
    can_repo
    case "${1:-}" in
      targets|create|status) exec sh "$T/ship.sh" "$@" ;;
      sweep) shift; exec sh "$T/ship-sweep.sh" "$@" ;;
      *) sai 2 "Dùng: aw ship targets|create|status <feature-dir> … | aw ship sweep [<branch>] [--apply]" ;;
    esac ;;
  adapter)
    [ "${1:-}" = build ] || sai 2 "Dùng: aw adapter build [<agent>[,<agent>…]] [--out <dir>] [--force]"
    shift
    . "$T/lib/adapter.sh"
    ag=""
    case "${1:-}" in ""|--*) ;; *) ag=$(al_chuan "$1"); shift ;; esac
    if [ -z "$ag" ]; then
      can_repo; ag=$(al_doc "$AW_CONFIG/config.sh")
    fi
    _e=$(al_kiem "$AW_ENGINE" "$ag" 2>&1) || sai 2 "$_e"
    out=""; force=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --out) [ -n "${2:-}" ] || sai 2 "LỖI: --out cần thư mục."; out=$2; shift 2 ;;
        --force) force=--force; shift ;;
        *) sai 2 "LỖI: tham số lạ \"$1\"." ;;
      esac
    done
    if [ -z "$out" ]; then can_repo; out=$AW_REPO; fi
    exec sh "$T/adapter-build.sh" "$ag" "$out" $force ;;
  ""|-h|--help|help)
    awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"
    [ -n "$LENH" ] || exit 2 ;;
  *) sai 2 "LỖI: lệnh lạ \"$LENH\" — xem: aw help" ;;
esac
